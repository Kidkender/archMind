{
  "name": "@kidkender/archmind",
  "version": "0.10.0",
  "description": "Find routes with missing authorization, lost transactions and unscoped tenant queries in Laravel, NestJS, Express, Spring Boot and Go/Gin apps — and fail CI when a refactor drops them. Offline, no LLM.",
  "type": "module",
  "bin": {
    "archmind": "./dist/index.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-php": "^0.22.0",
    "tree-sitter-java": "^0.23.5",
    "@kidkender/archmind-explainer": "*",
    "@kidkender/archmind-laravel-parser": "*",
    "@kidkender/archmind-llm-client": "*",
    "@kidkender/archmind-nestjs-parser": "*",
    "@kidkender/archmind-go-parser": "*",
    "@kidkender/archmind-express-parser": "*",
    "@kidkender/archmind-orchestrator": "*",
    "@kidkender/archmind-protocol": "*",
    "@kidkender/archmind-retrieval": "*",
    "@kidkender/archmind-scorer": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "laravel",
    "nestjs",
    "express",
    "spring-boot",
    "gin",
    "security",
    "authorization",
    "multi-tenant",
    "static-analysis",
    "sast",
    "ci",
    "cli",
    "github-actions",
    "execution-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kidkender/archMind.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.cjs",
    "CHANGELOG.md",
    "README.md"
  ],
  "homepage": "https://github.com/Kidkender/archMind#readme",
  "bugs": {
    "url": "https://github.com/Kidkender/archMind/issues"
  }
}
