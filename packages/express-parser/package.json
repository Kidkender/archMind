{
  "name": "@kidkender/archmind-express-parser",
  "version": "0.1.0",
  "description": "Static analysis parser for Express.js projects (JavaScript and TypeScript) — extracts routes, middleware chains and auth patterns into ArchMind IR graphs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/__tests__/**"
  ],
  "keywords": [
    "archmind",
    "express",
    "nodejs",
    "parser",
    "static-analysis"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Architecture-Mind/ArchMind#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Architecture-Mind/ArchMind",
    "directory": "packages/express-parser"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@kidkender/archmind-protocol": "^0.5.1",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
