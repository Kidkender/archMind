{
  "name": "@kidkender/archmind-mcp",
  "version": "0.8.0",
  "description": "MCP server that tells Claude Code, Cursor and other AI assistants what each route of your Laravel, NestJS, Express or Go/Gin app checks — and what it is missing (auth, policy, transaction, tenant scope).",
  "type": "module",
  "bin": {
    "archmind-mcp": "dist/index.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-php": "^0.22.0",
    "ts-morph": "^23.0.0",
    "@kidkender/archmind-laravel-parser": "*",
    "@kidkender/archmind-nestjs-parser": "*",
    "@kidkender/archmind-go-parser": "*",
    "@kidkender/archmind-express-parser": "*",
    "@kidkender/archmind-lens": "*",
    "@kidkender/archmind-retrieval": "*",
    "@kidkender/archmind-explainer": "*",
    "@kidkender/archmind-protocol": "*",
    "@kidkender/archmind-runtime-ingest": "*",
    "@kidkender/archmind-runtime-correlator": "*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0",
    "zod": "^3.0.0"
  },
  "keywords": [
    "laravel",
    "nestjs",
    "express",
    "gin",
    "security",
    "authorization",
    "multi-tenant",
    "static-analysis",
    "sast",
    "ci",
    "mcp",
    "mcp-server",
    "claude-code",
    "cursor",
    "ai",
    "execution-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kidkender/archMind.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/index.cjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Kidkender/archMind#readme",
  "bugs": {
    "url": "https://github.com/Kidkender/archMind/issues"
  }
}
